# EaseHub Environment Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Legacy MongoDB Rollback)
MONGO_URI=mongodb://localhost:27017/easehub

# JWT Authentication (Legacy Rollback)
JWT_SECRET=easehub_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=7d

# Frontend CORS URL
FRONTEND_URL=http://localhost:5173

# InsForge Project Credentials
INSFORGE_PROJECT_URL=https://<your-project-id>.insforge.app
INSFORGE_ANON_KEY=<your-insforge-anon-key>
INSFORGE_SERVICE_ROLE_KEY=<your-insforge-service-role-key>
